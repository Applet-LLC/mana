<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Mana.PastKeyboardsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Mana"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Past keyboards"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="HeaderText"
            FontSize="18"
            FontWeight="SemiBold" />

        <Grid Grid.Row="1">
            <TextBlock
                x:Name="EmptyText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.7"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <ListView
                x:Name="HistoryList"
                IsItemClickEnabled="True"
                ItemClick="HistoryList_ItemClick"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PastKeyboardItem">
                        <Grid ColumnSpacing="12" Padding="4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="160"
                                Height="80"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Opacity="0.7"
                                        Text="{x:Bind NoImageLabel}"
                                        Visibility="{x:Bind NoThumbnailVisibility}" />
                                    <Image
                                        Stretch="UniformToFill"
                                        Source="{x:Bind ThumbnailSource}"
                                        Visibility="{x:Bind ThumbnailVisibility}" />
                                </Grid>
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Text="{x:Bind DisplayName}"
                                TextWrapping="WrapWholeWords" />
                            <Border
                                Grid.Column="2"
                                Padding="8,4"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4"
                                Visibility="{x:Bind ConnectedVisibility}">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="{x:Bind ConnectedLabel}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
