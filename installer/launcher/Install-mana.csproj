<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Mana.Launcher</RootNamespace>
    <AssemblyName>Install-mana</AssemblyName>
    <Version>1.0.0</Version>
    <InformationalVersion>1.00</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>mana as setting keyboard layout</Product>
    <Company>Applet LLC</Company>
    <Description>mana as setting keyboard layout</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 配布用の dist へは Publish（単一ファイル）のときだけコピーする。通常 Build の apphost 単体では動かない。 -->
  <Target Name="CopyLauncherToDist" AfterTargets="Publish">
    <PropertyGroup>
      <_DistDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\dist'))\</_DistDir>
      <_LauncherExe Condition="'$(PublishDir)' != ''">$([System.IO.Path]::GetFullPath('$(PublishDir)'))\$(AssemblyName).exe</_LauncherExe>
      <_LauncherExe Condition="'$(_LauncherExe)' == '' or !Exists('$(_LauncherExe)')">$(TargetDir)$(AssemblyName).exe</_LauncherExe>
    </PropertyGroup>
    <Error Condition="!Exists('$(_LauncherExe)')"
           Text="Install-mana.exe not found at $(_LauncherExe)." />
    <MakeDir Directories="$(_DistDir)" />
    <Copy SourceFiles="$(_LauncherExe)" DestinationFiles="$(_DistDir)Install-mana.exe" OverwriteReadOnlyFiles="true" />
    <Message Importance="high" Text="Install-mana: copied $(_LauncherExe) → $(_DistDir)Install-mana.exe" />
  </Target>
</Project>
