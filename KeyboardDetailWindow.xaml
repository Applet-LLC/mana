<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Mana.KeyboardDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Keyboard"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock
                x:Name="TitleText"
                FontSize="18"
                FontWeight="SemiBold"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                x:Name="ShellNameText"
                FontSize="13"
                Opacity="0.8"
                TextWrapping="WrapWholeWords" />
            <TextBox
                x:Name="InstancePathBox"
                FontSize="12"
                IsReadOnly="True"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Name="StackSection" Grid.Row="1" Spacing="4">
            <TextBlock
                x:Name="DriverStackLabel"
                FontSize="14"
                FontWeight="SemiBold"
                Text="Driver Stack" />
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">
                <StackPanel
                    x:Name="StackPanel"
                    Orientation="Horizontal"
                    Spacing="0"
                    VerticalAlignment="Center" />
            </ScrollViewer>
        </StackPanel>

        <Grid Grid.Row="2" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="MemoLabel"
                FontSize="14"
                FontWeight="SemiBold"
                Text="Memo" />
            <!-- WebView2 は Visibility 切替。表示/編集は常に押せる1ボタンでトグル -->
            <StackPanel
                Grid.Row="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button x:Name="MemoModeButton" Click="MemoModeButton_Click" MinWidth="120">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock x:Name="MemoModeViewLabel" Text="表示" />
                        <TextBlock Text="/" Opacity="0.7" />
                        <TextBlock x:Name="MemoModeEditLabel" Text="編集" />
                    </StackPanel>
                </Button>
                <Button x:Name="MemoFontButton" Click="MemoFontButton_Click" />
            </StackPanel>
            <Grid Grid.Row="2" MinHeight="180">
                <WebView2
                    x:Name="MemoWebView"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
                <TextBox
                    x:Name="MemoViewFallbackBox"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    TextWrapping="Wrap"
                    Visibility="Collapsed"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <TextBox
                    x:Name="MemoEditBox"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Visibility="Collapsed"
                    VerticalAlignment="Stretch"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            Spacing="8">
            <Button x:Name="OpenFolderButton" Click="OpenFolderButton_Click" />
        </StackPanel>
    </Grid>
</Window>
