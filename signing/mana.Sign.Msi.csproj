<Project Sdk="Microsoft.Build.NoTargets/3.7.56">
  <!--
    英語版・日本語版 MSI に EV 署名する（成果物は版付きファイル名のみ）。
    ソリューションの一括ビルド対象外。VS ではこのプロジェクトを右クリック → ビルド。

    入力: installer\bin\Release\{culture}\manaSetup.msi（あれば）または
          dist の版付き MSI / 旧無版付き名。
    出力: installer\dist\manaSetup-1.00-{culture}.msi のみ（無版付き名は削除）。
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SignScript>$(MSBuildProjectDirectory)\EvCodeSign.ps1</SignScript>
    <InstallerDir>$(MSBuildProjectDirectory)\..\installer\</InstallerDir>
    <DistDir>$(InstallerDir)dist\</DistDir>
    <DisplayVersion>1.00</DisplayVersion>
    <MsiEnUs>$(DistDir)manaSetup-$(DisplayVersion)-en-US.msi</MsiEnUs>
    <MsiJaJp>$(DistDir)manaSetup-$(DisplayVersion)-ja-JP.msi</MsiJaJp>
    <LegacyEnUs>$(DistDir)manaSetup.en-US.msi</LegacyEnUs>
    <LegacyJaJp>$(DistDir)manaSetup.ja-JP.msi</LegacyJaJp>
    <BuiltEnUs>$(InstallerDir)bin\Release\en-US\manaSetup.msi</BuiltEnUs>
    <BuiltJaJp>$(InstallerDir)bin\Release\ja-JP\manaSetup.msi</BuiltJaJp>
  </PropertyGroup>

  <Target Name="SignMsis" AfterTargets="Build">
    <MakeDir Directories="$(DistDir)" />

    <!-- bin → 版付き。無ければ旧無版付き名を版付きへリネーム相当でコピー。 -->
    <Copy SourceFiles="$(BuiltEnUs)" DestinationFiles="$(MsiEnUs)" OverwriteReadOnlyFiles="true"
          Condition="Exists('$(BuiltEnUs)')" />
    <Copy SourceFiles="$(BuiltJaJp)" DestinationFiles="$(MsiJaJp)" OverwriteReadOnlyFiles="true"
          Condition="Exists('$(BuiltJaJp)')" />
    <Copy SourceFiles="$(LegacyEnUs)" DestinationFiles="$(MsiEnUs)" OverwriteReadOnlyFiles="true"
          Condition="!Exists('$(MsiEnUs)') AND Exists('$(LegacyEnUs)')" />
    <Copy SourceFiles="$(LegacyJaJp)" DestinationFiles="$(MsiJaJp)" OverwriteReadOnlyFiles="true"
          Condition="!Exists('$(MsiJaJp)') AND Exists('$(LegacyJaJp)')" />

    <Error Condition="!Exists('$(MsiEnUs)')"
           Text="MSI not found: $(MsiEnUs). Build manaSetup for en-US (Cultures=en-US) first." />
    <Error Condition="!Exists('$(MsiJaJp)')"
           Text="MSI not found: $(MsiJaJp). Build manaSetup for ja-JP (Cultures=ja-JP) first." />

    <ItemGroup>
      <_SignFile Include="$(MsiEnUs)" />
      <_SignFile Include="$(MsiJaJp)" />
    </ItemGroup>

    <Message Importance="high" Text="mana.Sign.Msi: signing @(_SignFile->'%(Filename)%(Extension)', ', ') in one signtool run..." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(SignScript)&quot; -Files &quot;@(_SignFile->'%(Identity)', ';')&quot;" />

    <Delete Files="$(LegacyEnUs)" Condition="Exists('$(LegacyEnUs)')" />
    <Delete Files="$(LegacyJaJp)" Condition="Exists('$(LegacyJaJp)')" />
    <Message Importance="high" Text="mana.Sign.Msi: distribution MSI are $(MsiEnUs) and $(MsiJaJp)" />
  </Target>
</Project>
