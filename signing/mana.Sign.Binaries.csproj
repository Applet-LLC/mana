<Project Sdk="Microsoft.Build.NoTargets/3.7.56">
  <!--
    最新のアプリ出力を publish\win-x64 へ同期してから mana.exe / mana.dll / Install-mana.exe に EV 署名する。
    VS の通常 Build は bin\x64\Release\... に出すため、Publish していないと MSI 用 publish が古いまま残る。
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SignScript>$(MSBuildProjectDirectory)\EvCodeSign.ps1</SignScript>
    <SyncScript>$(MSBuildProjectDirectory)\Sync-PublishPayload.ps1</SyncScript>
    <ResolveLauncherScript>$(MSBuildProjectDirectory)\Resolve-LauncherExe.ps1</ResolveLauncherScript>
    <!-- 末尾 \ は powershell -File の "..." を壊す（\" 扱いになる）ため付けない -->
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))</RepoRoot>
    <InstallerDir>$(RepoRoot)\installer</InstallerDir>
    <DistDir>$(InstallerDir)\dist</DistDir>
    <PublishDir>$(RepoRoot)\publish\win-x64\</PublishDir>
    <AppExe>$(PublishDir)mana.exe</AppExe>
    <AppDll>$(PublishDir)mana.dll</AppDll>
    <LauncherDir>$(InstallerDir)\launcher\bin</LauncherDir>
  </PropertyGroup>

  <Target Name="SignBinaries" AfterTargets="Build">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(SyncScript)&quot; -RepoRoot &quot;$(RepoRoot)&quot;"
          LogStandardErrorAsError="true" />

    <Error Condition="!Exists('$(AppExe)')"
           Text="mana.exe not found in $(PublishDir) after sync." />
    <Error Condition="!Exists('$(AppDll)')"
           Text="mana.dll not found in $(PublishDir) after sync." />
    <Error Condition="!Exists('$(PublishDir)KeyboardDetailWindow.xbf')"
           Text="KeyboardDetailWindow.xbf missing in $(PublishDir). Build mana before signing." />

    <Exec ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ResolveLauncherScript)&quot; -LauncherDir &quot;$(LauncherDir)&quot;">
      <Output TaskParameter="ConsoleOutput" ItemName="_LauncherResolved" />
    </Exec>
    <PropertyGroup>
      <LauncherExe>@(_LauncherResolved)</LauncherExe>
    </PropertyGroup>

    <ItemGroup>
      <_SignFile Include="$(AppExe)" />
      <_SignFile Include="$(AppDll)" />
      <_SignFile Include="$(LauncherExe)" />
    </ItemGroup>

    <Message Importance="high" Text="mana.Sign.Binaries: signing @(_SignFile->'%(Filename)%(Extension)', ', ') in one signtool run (waiting until finished)..." />
    <Message Importance="high" Text="mana.Sign.Binaries: Install-mana.exe = $(LauncherExe)" />

    <Exec Command="cmd /c powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(SignScript)&quot; -Files &quot;@(_SignFile->'%(Identity)', ';')&quot; &amp; exit /b %25ERRORLEVEL%"
          LogStandardErrorAsError="true" />

    <Message Importance="high" Text="mana.Sign.Binaries: signing finished; copying Install-mana.exe to dist" />
    <MakeDir Directories="$(DistDir)" />
    <Copy SourceFiles="$(LauncherExe)" DestinationFiles="$(DistDir)\Install-mana.exe" OverwriteReadOnlyFiles="true" />
    <Message Importance="high" Text="mana.Sign.Binaries: copied Install-mana.exe to $(DistDir)" />
  </Target>

  <Target Name="CleanDist" AfterTargets="Clean">
    <ItemGroup>
      <_DistClean Include="$(DistDir)\*.msi" />
      <_DistClean Include="$(DistDir)\Install-mana.exe" />
    </ItemGroup>
    <Delete Files="@(_DistClean)" TreatErrorsAsWarnings="true" />
    <!-- 古い単一ファイル publish が残ると、次の署名・配布でそれを拾ってしまうため一緒に消す。 -->
    <RemoveDir Directories="$(LauncherDir)\Release\net9.0-windows\win-x64\publish" ContinueOnError="true" />
    <Message Importance="high" Text="mana.Sign.Binaries: cleaned distribution artifacts in $(DistDir)" Condition="'@(_DistClean)' != ''" />
  </Target>
</Project>
