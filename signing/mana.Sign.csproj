<Project Sdk="Microsoft.Build.NoTargets/3.7.56">
  <!--
    通常の Debug/Release ビルドでは署名しない。
    installer\Build-Installer.ps1 が SignFiles ターゲットを、exe 署名と MSI 署名の二回呼ぶ。
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SignScript>$(MSBuildProjectDirectory)\EvCodeSign.ps1</SignScript>
  </PropertyGroup>

  <Target Name="Build">
    <Message Importance="high" Text="mana.Sign: a normal build does not sign. Use installer\Build-Installer.ps1." />
  </Target>

  <Target Name="SignPayload" DependsOnTargets="SignFiles" />
  <Target Name="SignDist" DependsOnTargets="SignFiles" />

  <Target Name="SignFiles">
    <Error Condition="'$(SignFiles)' == ''" Text="Pass /p:SignFiles=path1;path2" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(SignScript)&quot; -Files &quot;$(SignFiles)&quot;" />
  </Target>
</Project>
