<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>Mana</RootNamespace>
    <AssemblyName>mana</AssemblyName>
    <!-- MSI の ProductVersion はこの exe の FileVersion（1.0.0.0）から取る。外向け表示は InformationalVersion。 -->
    <Version>1.0.0</Version>
    <InformationalVersion>1.00</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>mana as setting keyboard layout</Product>
    <Company>Applet LLC</Company>
    <Description>mana as setting keyboard layout</Description>
    <!-- publish 出力とインストーラー、署名プロジェクトをアプリのビルド対象から外す。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**;installer\**;signing\**</DefaultItemExcludes>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!--
    unpackaged WinUI は mana.pri と *.xbf が exe と同じフォルダに無いと
    ms-appx:///MainWindow.xaml の解決に失敗する。Publish 直後に必ず検証する。
  -->
  <Target Name="VerifyWinUiPublishOutput" AfterTargets="Publish">
    <PropertyGroup>
      <_Pub>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))</_Pub>
    </PropertyGroup>
    <ItemGroup>
      <_RequiredWinUiPub Include="$(_Pub)mana.pri" />
      <_RequiredWinUiPub Include="$(_Pub)App.xbf" />
      <_RequiredWinUiPub Include="$(_Pub)MainWindow.xbf" />
      <_RequiredWinUiPub Include="$(_Pub)MainPage.xbf" />
    </ItemGroup>
    <Error Condition="!Exists('%(_RequiredWinUiPub.Identity)')"
           Text="WinUI resource missing after Publish: %(_RequiredWinUiPub.Identity). Use Visual Studio MSBuild Publish (publish.bat), not a partial copy of publish\win-x64." />
  </Target>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
  </ItemGroup>
</Project>
